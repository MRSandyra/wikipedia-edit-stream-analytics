# Environment variables untuk Wikipedia Edit Stream Analytics

# Redpanda configuration
REDPANDA_BOOTSTRAP_SERVERS=redpanda:9092
REDPANDA_TOPIC=wikipedia.recentchange.raw

# DuckDB paths
DUCKDB_PATH=/app/data/wikipedia.duckdb
BRONZE_PATH=/app/data/bronze

# Bronze retention (days)
MAX_BRONZE_RETENTION_DAYS=3

# Dashboard refresh interval (seconds)
DASHBOARD_REFRESH_INTERVAL=5

# Logging level
LOG_LEVEL=INFO